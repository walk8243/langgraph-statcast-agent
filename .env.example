# ==============================================================================
# Google Cloud & Pub/Sub Emulator
# ==============================================================================
GCP_PROJECT_ID=local-statcast-project
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PORT=8085
PUBSUB_TOPIC_STATCAST_RAW=statcast-raw-ingested
PUBSUB_SUBSCRIPTION_STATCAST_RAW=statcast-raw-ingested-sub

# ==============================================================================
# ClickHouse (Column-oriented DB for Raw Pitch-by-Pitch Data & Analytics)
# ==============================================================================
CLICKHOUSE_DB=statcast
CLICKHOUSE_USER=statcast
CLICKHOUSE_PASSWORD=statcast_pass
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ==============================================================================
# PostgreSQL (Relational DB for Master Data, Summaries & Agent State)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_DB=statcast
POSTGRES_USER=statcast
POSTGRES_PASSWORD=statcast_pass
POSTGRES_PORT=5432

# ==============================================================================
# AI Agent (LangGraph / Google Gemini)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
